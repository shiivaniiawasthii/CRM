
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String?
  googleId           String?  @unique
  name               String
  stripeCustomerId   String?  @unique
  subscriptionStatus String   @default("free")
  createdAt          DateTime @default(now())
}


